{"text": "<meta name=\"dash-one-writer\">\n<style>\n#dash-root { --dash-gutter: clamp(16px, 3vw, 32px); }\n.ml { display: flex; flex-direction: column; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); max-width: 78rem; margin-inline: auto; }\n.ml-head { display: flex; flex-direction: column; gap: var(--cds-gap-sm); }\n.ml-head h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n.ml-lede { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-body); max-width: 72ch; line-height: 1.5; }\n.ml .ml-lede b { color: var(--color-fg); font-weight: 600; font-variant-numeric: tabular-nums; }\n.ml-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr)); gap: var(--cds-gap-md); }\n.ml-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-md); display: flex; flex-direction: column; gap: var(--cds-gap-xs); min-width: 0; }\n.ml-lab { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.ml-num { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; line-height: 1.1; }\n.ml-sub { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.ml-section { display: flex; flex-direction: column; gap: var(--cds-gap-sm); }\n.ml-section > h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.ml-section > p { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); max-width: 80ch; }\n.ml-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--cds-gap-md); }\n.ml-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-sm); min-width: 0; }\n.ml-card h3 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.ml-note { margin: 0; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.ml-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.ml-legend span { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); }\n.ml-sw { display: inline-block; width: 0.625rem; height: 0.625rem; border-radius: 2px; background: var(--cds-chart-muted); }\n.ml-sw-ok { background: var(--color-ok); } .ml-sw-warn { background: var(--color-warn); } .ml-sw-bad { background: var(--color-bad); }\n.ml-chart { position: relative; min-height: 240px; }\n.ml-chart-short { min-height: 130px; }\n.ml-tip { position: absolute; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); pointer-events: none; white-space: nowrap; z-index: 2; font-variant-numeric: tabular-nums; }\n.ml-tip .t { color: var(--cds-text-secondary); }\n.ml-fail { display: flex; align-items: center; justify-content: center; gap: var(--cds-gap-xs); min-height: inherit; height: 100%; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.ml-fail i { width: 0.375rem; height: 0.375rem; border-radius: 50%; background: var(--color-bad); }\n.ml-tbl { max-height: 26rem; overflow: auto; }\n.ml table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.ml th { position: sticky; top: 0; background: var(--color-panel); text-align: left; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); }\n.ml th, .ml td { padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n.ml td.n, .ml th.n { text-align: right; }\n.ml-search { font: inherit; font-size: var(--cds-font-size-caption); padding: var(--cds-pad-xs) var(--cds-pad-sm); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: var(--color-bg); color: var(--color-fg); width: min(100%, 18rem); }\n.ml-search:focus-visible { outline: 2px solid var(--color-fg-muted); outline-offset: 1px; }\n.ml-tbl-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--cds-gap-sm); }\n[data-dash-source-state=empty] { color: transparent; }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n@media (max-width: 40rem) { .ml-hide-narrow { display: none; } }\n</style>\n\n<div class=\"ml\">\n  <header class=\"ml-head\">\n    <h1 id=\"title\">Evo-sim math ledger</h1>\n    <p class=\"ml-lede\"><b data-draw=\"t-checks\" data-source=\"checkcount\" data-field=\"calculated\">\u2014</b> checks have been calculated, and <b data-draw=\"t-flight\" data-source=\"checkcount\" data-field=\"in_flight\">\u2014</b> more are in flight. <b data-draw=\"t-pending\" data-source=\"burndown\" data-row=\"9\" data-field=\"pending_fields\">\u2014</b> verdict fields are still open, unchanged since mid-October. The math map, which breaks each argument down to its underlying maths, so far covers one branch and one video. Of its <b data-draw=\"t-objs\" data-source=\"objcount\" data-field=\"total\">\u2014</b> objects, <b data-draw=\"t-res\" data-source=\"objcount\" data-field=\"resolved\">\u2014</b> are settled.</p>\n  </header>\n\n  <div class=\"ml-tiles\">\n    <div class=\"ml-tile\"><span class=\"ml-lab\">Checks calculated</span><span class=\"ml-num\" data-draw=\"k-checks\" data-source=\"checkcount\" data-field=\"calculated\">\u2014</span><span class=\"ml-sub\">pre-registered and run</span></div>\n    <div class=\"ml-tile\"><span class=\"ml-lab\">Checks in flight</span><span class=\"ml-num\" data-draw=\"k-flight\" data-source=\"checkcount\" data-field=\"in_flight\">\u2014</span><span class=\"ml-sub\">registered, not finished</span></div>\n    <div class=\"ml-tile\"><span class=\"ml-lab\">Open verdict fields</span><span class=\"ml-num\" data-draw=\"k-pending\" data-source=\"burndown\" data-row=\"9\" data-field=\"pending_fields\">\u2014</span><span class=\"ml-sub\">across all claims</span></div>\n    <div class=\"ml-tile\"><span class=\"ml-lab\">Load-bearing claims open</span><span class=\"ml-num\" data-draw=\"k-lb\" data-source=\"burndown\" data-row=\"9\" data-field=\"load_bearing_open\">\u2014</span><span class=\"ml-sub\">these gate the exit</span></div>\n    <div class=\"ml-tile\"><span class=\"ml-lab\">Math objects settled</span><span class=\"ml-num\" data-draw=\"k-res\" data-source=\"objcount\" data-field=\"resolved\">\u2014</span><span class=\"ml-sub\">mapped so far: branch A and one video</span></div>\n    <div class=\"ml-tile\"><span class=\"ml-lab\">Mapped compute left</span><span class=\"ml-num\" data-draw=\"k-cpu\" data-source=\"objcount\" data-field=\"cpu_open\">\u2014</span><span class=\"ml-sub\">CPU-hours, estimated, branch A only</span></div>\n  </div>\n\n  <section class=\"ml-section\" id=\"calculated\">\n    <h2>What has been calculated</h2>\n    <p>Checks are the maths the audit has actually run. Each claim gets three verdicts (internal, fidelity, external). A claim counts as done once it has been reviewed.</p>\n    <div class=\"ml-grid\">\n      <div class=\"ml-card\">\n        <h3 id=\"burn-title\">Open verdict fields over time</h3>\n        <p class=\"ml-note\">Pending fields in the claim tree, from the last commit on or before each date. The line has been flat since mid-October.</p>\n        <div class=\"ml-chart\" data-draw=\"burn\" data-source=\"burndown\"></div>\n      </div>\n      <div class=\"ml-card\">\n        <h3 id=\"branch-title\">Claims by branch</h3>\n        <p class=\"ml-note\">How far each branch has got. Grey bars are claims that have never been checked.</p>\n        <div class=\"ml-legend\"><span><i class=\"ml-sw\" data-sw=\"0\"></i>Reviewed</span><span><i class=\"ml-sw\" data-sw=\"1\"></i>Checked</span><span><i class=\"ml-sw\"></i>Not yet checked</span></div>\n        <div class=\"ml-chart\" data-draw=\"branches\" data-source=\"branches\"></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"ml-section\" id=\"left\">\n    <h2>What is left</h2>\n    <p>The math map reduces every argument to its underlying math objects: an equation, a parameter, a model choice or a reasoning step. Settling an object settles every claim that rests on it. Branch A is an unmerged pilot, so duplicates are still in it.</p>\n    <div class=\"ml-grid\">\n      <div class=\"ml-card\">\n        <h3 id=\"obj-title\">Math objects by status</h3>\n        <p class=\"ml-note\">Settled means a named result already answers the maths. Blocked means it waits on a source or on the author.</p>\n        <div class=\"ml-legend\"><span><i class=\"ml-sw ml-sw-ok\"></i>Settled</span><span><i class=\"ml-sw ml-sw-bad\"></i>Blocked</span><span><i class=\"ml-sw ml-sw-warn\"></i>Open</span></div>\n        <div class=\"ml-chart ml-chart-short\" data-draw=\"objs\" data-source=\"objects\"></div>\n      </div>\n      <div class=\"ml-card\">\n        <h3 id=\"phase-title\">Phases to the exit</h3>\n        <p class=\"ml-note\">Sizes and CPU are estimates, projected from the branch A pilot. CPU is not the constraint: even the high end fits on the hosts we have.</p>\n        <div class=\"ml-tbl\">\n          <table data-source=\"phases\" data-row-key=\"phase\">\n            <thead><tr><th data-field=\"phase\">Phase</th><th data-field=\"work\">Work</th><th data-field=\"size\">Size</th><th class=\"n\" data-field=\"cpu_h_high\">CPU-h (high)</th><th class=\"ml-hide-narrow\" data-field=\"blocked\">Waits on</th></tr></thead>\n            <tbody data-draw=\"phase-rows\"></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n    <div class=\"ml-card\">\n      <h3 id=\"open-title\">Open and blocked math objects</h3>\n      <p class=\"ml-note\">Every object in the map that is not yet settled, with the claims it feeds. Simulations and regressions carry a CPU estimate.</p>\n      <div class=\"ml-tbl\">\n        <table data-source=\"openobjects\" data-row-key=\"key\">\n          <thead><tr><th data-field=\"key\">Object</th><th data-field=\"status\">Status</th><th data-field=\"resolution\">Settle by</th><th data-field=\"statement\">The maths</th><th class=\"ml-hide-narrow\" data-field=\"nodes\">Claims</th><th class=\"n\" data-field=\"cpu_h\">CPU-h</th></tr></thead>\n          <tbody data-draw=\"open-rows\"></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"ml-section\" id=\"checks\">\n    <h2>Every check</h2>\n    <div class=\"ml-card\">\n      <div class=\"ml-tbl-head\"><h3 id=\"checks-title\">Checks, calculated and in flight</h3><input id=\"check-search\" class=\"ml-search\" type=\"search\" placeholder=\"Search checks\" aria-label=\"Search checks\"></div>\n      <p class=\"ml-note\">Calculated checks are listed in PREREG-STATUS.md, with their pre-registration label. In-flight checks come from the git log since then.</p>\n      <div class=\"ml-tbl\">\n        <table data-source=\"checks\" data-row-key=\"check\">\n          <thead><tr><th data-field=\"check\">Check</th><th data-field=\"status\">Status</th><th class=\"ml-hide-narrow\" data-field=\"tier\">Tier</th><th data-field=\"script\">Script</th><th data-field=\"label\">Label or state</th></tr></thead>\n          <tbody data-draw=\"check-rows\"></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n</div>\n\n<script>\ndash.calc('checkcount', {\n  inputs: ['checks'], title: 'Checks by status',\n  description: 'Counts checks that are calculated and checks in flight.',\n  fn: (checks) => [{\n    calculated: checks.filter((c) => c.status === 'calculated').length,\n    in_flight: checks.filter((c) => c.status === 'in flight').length,\n  }],\n});\ndash.calc('objcount', {\n  inputs: ['objects'], title: 'Math objects by status',\n  description: 'Counts mapped math objects by status and sums the estimated CPU-hours of those not settled.',\n  fn: (objects) => [{\n    total: objects.length,\n    resolved: objects.filter((o) => o.status === 'resolved').length,\n    open: objects.filter((o) => o.status === 'open').length,\n    blocked: objects.filter((o) => o.status === 'blocked').length,\n    cpu_open: objects.filter((o) => o.status !== 'resolved').reduce((s, o) => s + Number(o.cpu_h || 0), 0),\n  }],\n});\ndash.calc('openobjects', {\n  inputs: ['objects'], title: 'Math objects not yet settled',\n  description: 'The mapped math objects whose status is open or blocked.',\n  fn: (objects) => objects.filter((o) => o.status !== 'resolved'),\n});\n\nwindow.mlFmt = d3.format(',');\nwindow.mlReady = (el, d) => {\n  if (d.status === 'ok') { el.classList.remove('dash-skeleton'); return true; }\n  el.replaceChildren();\n  if (d.status === 'loading') { el.classList.add('dash-skeleton'); return false; }\n  el.classList.remove('dash-skeleton');\n  if (d.status === 'error' || d.status === 'missing') {\n    const f = document.createElement('div'); f.className = 'ml-fail';\n    f.append(document.createElement('i'), 'Failed to load'); el.append(f);\n  } else { el.textContent = '\u2014'; }\n  return false;\n};\nwindow.mlNumber = (el, id, field, row, fmt) => {\n  const d = dash.data(id);\n  if (d.status !== 'ok' || !d.data.length) { el.textContent = '\u2014'; return; }\n  const v = d.data[row == null ? 0 : row][field];\n  el.textContent = fmt ? fmt(v) : window.mlFmt(v);\n};\nwindow.mlTip = (box) => {\n  let t = box.querySelector('.ml-tip');\n  if (!t) { t = document.createElement('div'); t.className = 'ml-tip'; t.hidden = true; box.append(t); }\n  return {\n    show(x, y, head, lines) {\n      t.replaceChildren();\n      const h = document.createElement('div'); h.className = 't'; h.textContent = head; t.append(h);\n      lines.forEach((l) => { const r = document.createElement('div'); r.textContent = l; t.append(r); });\n      t.hidden = false;\n      const bw = box.clientWidth, tw = t.offsetWidth;\n      t.style.left = Math.max(0, Math.min(bw - tw, x + 12)) + 'px';\n      t.style.top = Math.max(0, y - 10) + 'px';\n    },\n    hide() { t.hidden = true; },\n  };\n};\n</script>\n\n<script>\nconst lastRow = 9;\n[['t-checks', 'checkcount', 'calculated'], ['k-checks', 'checkcount', 'calculated'],\n ['t-flight', 'checkcount', 'in_flight'], ['k-flight', 'checkcount', 'in_flight'],\n ['t-objs', 'objcount', 'total'], ['t-res', 'objcount', 'resolved'], ['k-res', 'objcount', 'resolved'],\n].forEach(([name, id, field]) => dash.draw(name, (el) => window.mlNumber(el, id, field)));\ndash.draw('k-cpu', (el) => window.mlNumber(el, 'objcount', 'cpu_open', 0, d3.format(',.0f')));\n[['t-pending', 'pending_fields'], ['k-pending', 'pending_fields'], ['k-lb', 'load_bearing_open']]\n  .forEach(([name, field]) => dash.draw(name, (el) => window.mlNumber(el, 'burndown', field, lastRow)));\n\ndocument.querySelectorAll('[data-sw]').forEach((s) => { s.style.background = dash.colors[Number(s.dataset.sw)]; });\n</script>\n\n<script>\ndash.draw('burn', (el) => {\n  const d = dash.data('burndown');\n  if (!window.mlReady(el, d)) return;\n  el.replaceChildren();\n  const rows = d.data.map((r) => ({ ...r, t: new Date(r.date + 'T00:00:00Z'), v: Number(r.pending_fields) }));\n  const W = Math.max(280, el.clientWidth), H = 240, m = { t: 14, r: 44, b: 26, l: 36 };\n  const x = d3.scaleUtc(d3.extent(rows, (r) => r.t), [m.l, W - m.r]);\n  const y = d3.scaleLinear([0, Math.max(160, d3.max(rows, (r) => r.v))], [H - m.b, m.t]).nice();\n  const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-labelledby', 'burn-title');\n  svg.append('g').selectAll('line').data(y.ticks(4)).join('line')\n    .attr('x1', m.l).attr('x2', W - m.r).attr('y1', y).attr('y2', y).style('stroke', 'var(--cds-chart-grid)');\n  svg.append('g').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(4).tickSize(0))\n    .attr('font-size', null).attr('font-family', null).call((g) => g.select('.domain').remove())\n    .selectAll('text').style('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)');\n  const nTicks = W < 420 ? 3 : 5;\n  svg.append('g').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).ticks(nTicks).tickFormat(d3.utcFormat('%b %-d')).tickSizeOuter(0))\n    .attr('font-size', null).attr('font-family', null)\n    .call((g) => g.select('.domain').style('stroke', 'var(--cds-chart-axis)'))\n    .call((g) => g.selectAll('.tick line').style('stroke', 'var(--cds-chart-axis)'))\n    .selectAll('text').style('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)');\n  const c = dash.colors[0];\n  svg.append('path').datum(rows).attr('d', d3.line((r) => x(r.t), (r) => y(r.v)))\n    .style('fill', 'none').style('stroke', c).attr('stroke-width', 2).attr('stroke-linecap', 'round').attr('stroke-linejoin', 'round');\n  svg.append('g').selectAll('circle').data(rows).join('circle').attr('cx', (r) => x(r.t)).attr('cy', (r) => y(r.v)).attr('r', 3).style('fill', c);\n  const last = rows[rows.length - 1];\n  svg.append('text').attr('x', x(last.t) + 6).attr('y', y(last.v) + 4).text(window.mlFmt(last.v))\n    .style('fill', 'var(--color-fg)').style('font-size', 'var(--cds-font-size-caption)');\n  const tip = window.mlTip(el), hover = svg.append('circle').attr('r', 5).style('fill', c).attr('opacity', 0);\n  svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', W - m.l - m.r).attr('height', H - m.t - m.b).style('fill', 'transparent')\n    .on('pointermove', (ev) => {\n      const [px] = d3.pointer(ev), i = d3.leastIndex(rows, (r) => Math.abs(x(r.t) - px)), r = rows[i];\n      hover.attr('cx', x(r.t)).attr('cy', y(r.v)).attr('opacity', 1);\n      const sx = el.clientWidth / W;\n      tip.show(x(r.t) * sx, y(r.v) * sx, d3.utcFormat('%b %-d')(r.t), [`${window.mlFmt(r.v)} open fields`, `${r.load_bearing_open} of ${r.load_bearing} load-bearing open`, `${r.nodes} claims`]);\n    })\n    .on('pointerleave', () => { hover.attr('opacity', 0); tip.hide(); });\n});\n</script>\n\n<script>\nwindow.mlStack = (el, rows, label, keys, colors, names, aria) => {\n  el.replaceChildren();\n  const W = Math.max(280, el.clientWidth), bh = 22, gap = 10, m = { t: 4, r: 40, b: 4, l: 0 };\n  const svg = d3.select(el).append('svg').attr('width', '100%').attr('role', 'img').attr('aria-labelledby', aria);\n  const probe = svg.append('text').style('font-size', 'var(--cds-font-size-caption)');\n  m.l = 8 + d3.max(rows, (r) => { probe.text(r[label]); return probe.node().getComputedTextLength(); });\n  probe.remove();\n  const H = m.t + m.b + rows.length * (bh + gap) - gap;\n  svg.attr('viewBox', `0 0 ${W} ${H}`);\n  const tot = (r) => keys.reduce((s, k) => s + Number(r[k] || 0), 0);\n  const x = d3.scaleLinear([0, d3.max(rows, tot)], [m.l, W - m.r]);\n  const tip = window.mlTip(el), sx = () => el.clientWidth / W;\n  rows.forEach((r, i) => {\n    const y0 = m.t + i * (bh + gap);\n    svg.append('text').attr('x', m.l - 8).attr('y', y0 + bh / 2 + 4).attr('text-anchor', 'end').text(r[label])\n      .style('fill', 'var(--color-fg)').style('font-size', 'var(--cds-font-size-caption)');\n    let acc = 0;\n    keys.forEach((k, j) => {\n      const v = Number(r[k] || 0); if (!v) return;\n      svg.append('rect').attr('x', x(acc)).attr('y', y0).attr('width', Math.max(0, x(acc + v) - x(acc) - 1)).attr('height', bh).attr('rx', 2)\n        .style('fill', colors[j]);\n      acc += v;\n    });\n    svg.append('text').attr('x', x(acc) + 6).attr('y', y0 + bh / 2 + 4).text(window.mlFmt(acc))\n      .style('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)');\n    svg.append('rect').attr('x', 0).attr('y', y0).attr('width', W).attr('height', bh).style('fill', 'transparent')\n      .on('pointermove', (ev) => { const [px, py] = d3.pointer(ev); tip.show(px * sx(), py * sx(), String(r[label]), keys.map((k, j) => `${names[j]}: ${window.mlFmt(Number(r[k] || 0))}`)); })\n      .on('pointerleave', () => tip.hide());\n  });\n};\n\ndash.draw('branches', (el) => {\n  const d = dash.data('branches');\n  if (!window.mlReady(el, d)) return;\n  window.mlStack(el, d.data, 'branch', ['reviewed', 'checked', 'extracted'],\n    [dash.colors[0], dash.colors[1], 'var(--cds-chart-muted)'], ['Reviewed', 'Checked', 'Not yet checked'], 'branch-title');\n});\n\ndash.draw('objs', (el) => {\n  const d = dash.data('objects');\n  if (!window.mlReady(el, d)) return;\n  const maps = d3.rollups(d.data, (v) => ({\n    resolved: v.filter((o) => o.status === 'resolved').length,\n    blocked: v.filter((o) => o.status === 'blocked').length,\n    open: v.filter((o) => o.status === 'open').length,\n  }), (o) => o.map).map(([map, c]) => ({ map, ...c }));\n  window.mlStack(el, maps, 'map', ['resolved', 'blocked', 'open'],\n    ['var(--color-ok)', 'var(--color-bad)', 'var(--color-warn)'], ['Settled', 'Blocked', 'Open'], 'obj-title');\n});\n</script>\n\n<script>\nwindow.mlRows = (tbody, rows, cols) => {\n  tbody.replaceChildren(...rows.map((r) => {\n    const tr = document.createElement('tr');\n    cols.forEach(([f, cls, fmt]) => {\n      const td = document.createElement('td'); if (cls) td.className = cls;\n      td.textContent = fmt ? fmt(r[f]) : (r[f] == null ? '' : String(r[f]));\n      tr.append(td);\n    });\n    return tr;\n  }));\n};\nconst cpuFmt = (v) => (Number(v) ? d3.format(',.0f')(Number(v)) : '');\n\ndash.draw('phase-rows', (tb) => {\n  const d = dash.data('phases');\n  if (d.status !== 'ok') { tb.replaceChildren(); return; }\n  window.mlRows(tb, d.data, [['phase'], ['work'], ['size'], ['cpu_h_high', 'n', cpuFmt], ['blocked', 'ml-hide-narrow']]);\n});\n\ndash.draw('open-rows', (tb) => {\n  const d = dash.data('openobjects');\n  if (d.status !== 'ok') { tb.replaceChildren(); return; }\n  const order = { blocked: 0, open: 1 };\n  const rows = [...d.data].sort((a, b) => (order[a.status] - order[b.status]) || (Number(b.cpu_h) - Number(a.cpu_h)) || a.key.localeCompare(b.key));\n  window.mlRows(tb, rows, [['key'], ['status'], ['resolution'], ['statement'], ['nodes', 'ml-hide-narrow'], ['cpu_h', 'n', cpuFmt]]);\n});\n\ndash.draw('check-rows', (tb) => {\n  const d = dash.data('checks');\n  if (d.status !== 'ok') { tb.replaceChildren(); return; }\n  const qs = [...document.querySelectorAll('#check-search')].map((i) => i.value.trim().toLowerCase()).filter(Boolean);\n  const q = qs[0] || '';\n  const rows = [...d.data].sort((a, b) => (a.status === b.status ? 0 : a.status === 'in flight' ? -1 : 1))\n    .filter((r) => !q || [r.check, r.tier, r.script, r.label, r.status].join(' ').toLowerCase().includes(q));\n  window.mlRows(tb, rows, [['check'], ['status'], ['tier', 'ml-hide-narrow'], ['script'], ['label']]);\n});\ndocument.querySelectorAll('#check-search').forEach((i) => i.addEventListener('input', () => dash.draw('check-rows')));\n</script>\n"}